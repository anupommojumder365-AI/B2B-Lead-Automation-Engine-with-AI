        "responses": {
          "values": [
            {
              "content": "=You are an expert B2B Lead Qualification AI. Analyze the following lead details and assign a lead score and tier based on ideal customer criteria.\n\nLead Information:\n- Full Name: {{ $json.full_name }}\n- Job Title: {{ $json.job_title }}\n- Company Name: {{ $json.enriched_company_name }}\n- Company Size: {{ $json.company_size }}\n- Budget: {{ $json.budget }}\n- Timeline: {{ $json.timeline }}\n- Service Needed: {{ $json.service_needed }}\n- Notes: {{ $json.notes }}\n\nReturn ONLY a raw JSON object with no markdown syntax, no quotes around the JSON block, and strictly adhering to this structure:\n{\n  \"lead_score\": 85,\n  \"lead_tier\": \"HOT\",\n  \"qualification_reason\": \"Decision-maker role (CMO), high budget ($5k-$10k), urgent timeline (30 days), and clear service fit.\",\n  \"recommended_action\": \"Assign to Senior Sales Rep immediately for booking a call.\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
