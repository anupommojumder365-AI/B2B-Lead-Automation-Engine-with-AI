      "parameters": {
        "jsCode": "// Retrieve incoming payload from Node 1\nconst items = $input.all();\n\nreturn items.map(item => {\n  const body = item.json.body || item.json;\n\n  // Generate date string (YYYYMMDD)\n  const now = new Date();\n  const dateStr = now.toISOString().slice(0, 10).replace(/-/g, \"\");\n  \n  // Generate random 4-character alphanumeric hash\n  const randomHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n  \n  // Construct Unique Lead ID\n  const leadId = `LEAD-${dateStr}-${randomHash}`;\n  \n  return {\n    json: {\n      lead_id: leadId,\n      received_at: now.toISOString(),\n      system_source: body.lead_source || \"Website Intake Webhook\",\n      raw_data: body\n    }\n  };\n});"
      },
