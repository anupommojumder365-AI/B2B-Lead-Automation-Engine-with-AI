    {
      "parameters": {
        "jsCode": "// Retrieve enriched lead payload from Node 12\nconst mainLead = $(\"Merge Enriched Data\").first().json;\n\n// Retrieve raw text response from OpenAI (Node 13)\nconst aiResponseText = $input.first().json.output[0].content[0].text;\n\n// Parse string JSON to JS Object safely\nlet aiData = {};\ntry {\n  aiData = JSON.parse(aiResponseText);\n} catch (e) {\n  aiData = {\n    lead_score: 50,\n    lead_tier: \"WARM\",\n    qualification_reason: \"Failed to parse AI response.\",\n    recommended_action: \"Manual review required.\"\n  };\n}\n\nreturn [{\n  json: {\n    ...mainLead,\n    lead_score: aiData.lead_score || 0,\n    lead_tier: aiData.lead_tier || \"UNKNOWN\",\n    qualification_reason: aiData.qualification_reason || \"\",\n    recommended_action: aiData.recommended_action || \"\",\n    lead_stage: aiData.lead_tier === \"HOT\" ? \"SALES_READY\" : \"NURTURE\"\n  }\n}];"
