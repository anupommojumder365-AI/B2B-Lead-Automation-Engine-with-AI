    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  // Helper functions for string sanitization\n  const cleanText = (str) => str ? str.toString().trim() : \"\";\n  const capitalize = (str) => {\n    const cleaned = cleanText(str);\n    return cleaned ? cleaned.charAt(0).toUpperCase() + cleaned.slice(1).toLowerCase() : \"\";\n  };\n\n  // 1. Lowercase and trim email\n  const cleanedEmail = cleanText(data.email).toLowerCase();\n\n  // 2. Format phone number (remove spaces, brackets, dashes, keep + and digits)\n  const rawPhone = cleanText(data.phone);\n  const cleanedPhone = rawPhone.replace(/[^\\d+]/g, '');\n\n  // 3. Format website URL\n  let website = cleanText(data.company_website).toLowerCase();\n  if (website && !website.startsWith('http://') && !website.startsWith('https://')) {\n    website = 'https://' + website;\n  }\n\n  // 4. Construct Clean Object\n  return {\n    json: {\n      ...data,\n      first_name: capitalize(data.first_name),\n      last_name: capitalize(data.last_name),\n      full_name: `${capitalize(data.first_name)} ${capitalize(data.last_name)}`.trim(),\n      email: cleanedEmail,\n      phone: cleanedPhone,\n      company_name: cleanText(data.company_name),\n      company_website: website,\n      job_title: cleanText(data.job_title),\n      data_normalized: true\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
