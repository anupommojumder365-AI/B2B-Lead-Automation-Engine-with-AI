      "parameters": {
        "jsCode": "// Retrieve main lead payload from Node 10\nconst mainLead = $(\"Prepare New Lead Payload\").first().json;\n\n// Retrieve enriched company data from Node 11\nconst clearbitResult = $input.first()?.json || {};\n\nreturn [{\n  json: {\n    ...mainLead,\n    enriched_company_name: clearbitResult.name || mainLead.company_name,\n    enriched_company_domain: clearbitResult.domain || mainLead.email_domain,\n    enriched_company_logo: clearbitResult.logo || null,\n    is_enriched: clearbitResult.name ? true : false\n  }\n}];"
